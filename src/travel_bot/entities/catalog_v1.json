{
  "schema_version": "v1",
  "entities": [
    {
      "key": "destination",
      "label": "Destination",
      "type": "location",
      "tier": "required",
      "required_rule": "always",
      "ask_rule": "always",
      "priority": 10,
      "dependencies": [],
      "ask_with": [],
      "normalizer": "location",
      "validation_rule": "location",
      "allowed_statuses": ["known", "flexible", "ambiguous", "declined"],
      "value_format": "{\"city\": str|null, \"region\": str|null, \"country\": str|null, \"description\": str|null}  e.g. {\"city\": \"Rome\", \"country\": \"Italy\"}; use description for vague wishes like \"somewhere warm\" (status flexible)",
      "question_template": "Where are you thinking of going?"
    },
    {
      "key": "interests",
      "label": "Interests",
      "type": "list",
      "tier": "optional",
      "required_rule": "never",
      "ask_rule": "destination_flexible",
      "priority": 15,
      "dependencies": [],
      "ask_with": [],
      "normalizer": "list",
      "validation_rule": "list",
      "allowed_statuses": ["known", "flexible", "declined"],
      "value_format": "{\"items\": [str]}  e.g. {\"items\": [\"beaches\", \"food\"]}",
      "question_template": "No problem! What kind of trip are you in the mood for: beaches, cities, nature, food, culture, or something else?"
    },
    {
      "key": "origin",
      "label": "Departing from",
      "type": "location",
      "tier": "required",
      "required_rule": "always",
      "ask_rule": "always",
      "priority": 20,
      "dependencies": [],
      "ask_with": [],
      "normalizer": "location",
      "validation_rule": "location",
      "allowed_statuses": ["known", "flexible", "ambiguous", "not_applicable", "declined"],
      "value_format": "{\"city\": str|null, \"airport_code\": str|null, \"country\": str|null}  e.g. {\"city\": \"Austin\", \"country\": \"United States\"}",
      "question_template": "Where will you be traveling from?"
    },
    {
      "key": "departure_date",
      "label": "Departure date",
      "type": "date",
      "tier": "required",
      "required_rule": "always",
      "ask_rule": "always",
      "priority": 30,
      "dependencies": [],
      "ask_with": [],
      "normalizer": "date",
      "validation_rule": "future_date",
      "allowed_statuses": ["known", "flexible", "ambiguous", "declined"],
      "value_format": "exact: {\"date\": \"YYYY-MM-DD\"}; partial/range (status flexible): {\"earliest\": \"YYYY-MM-DD\", \"latest\": \"YYYY-MM-DD\"}",
      "question_template": "When would you like to leave?"
    },
    {
      "key": "trip_type",
      "label": "Trip type",
      "type": "enum",
      "tier": "required",
      "required_rule": "always",
      "ask_rule": "always",
      "priority": 40,
      "dependencies": [],
      "ask_with": ["return_date"],
      "normalizer": "trip_type",
      "validation_rule": "trip_type",
      "allowed_statuses": ["known", "ambiguous", "declined"],
      "value_format": "{\"type\": \"one_way\"|\"round_trip\"|\"multi_city\"|\"other\"}",
      "question_template": "Is this a round trip, and if so, when would you like to come back?"
    },
    {
      "key": "return_date",
      "label": "Return date",
      "type": "date",
      "tier": "conditional",
      "required_rule": "round_trip_needs_end",
      "ask_rule": "always",
      "priority": 45,
      "dependencies": ["trip_type", "departure_date"],
      "ask_with": ["trip_duration"],
      "normalizer": "date",
      "validation_rule": "future_date",
      "allowed_statuses": ["known", "flexible", "ambiguous", "not_applicable", "declined"],
      "value_format": "exact: {\"date\": \"YYYY-MM-DD\"}; range (status flexible): {\"earliest\": \"YYYY-MM-DD\", \"latest\": \"YYYY-MM-DD\"}",
      "question_template": "When would you like to come back, or roughly how long is the trip?"
    },
    {
      "key": "trip_duration",
      "label": "Trip length",
      "type": "duration",
      "tier": "optional",
      "required_rule": "never",
      "ask_rule": "never",
      "priority": 46,
      "dependencies": [],
      "ask_with": [],
      "normalizer": "duration",
      "validation_rule": "duration",
      "allowed_statuses": ["known", "flexible", "ambiguous", "declined"],
      "value_format": "{\"nights\": int}  (a week = 7 nights; for days-only phrasing use {\"days\": int})",
      "question_template": "Roughly how long would you like the trip to be?"
    },
    {
      "key": "travelers.adults",
      "label": "Adults",
      "type": "count",
      "tier": "required",
      "required_rule": "always",
      "ask_rule": "always",
      "priority": 50,
      "dependencies": [],
      "ask_with": ["travelers.children"],
      "normalizer": "count",
      "validation_rule": "party_size",
      "allowed_statuses": ["known", "ambiguous", "declined"],
      "value_format": "{\"count\": int}",
      "question_template": "How many people are traveling, and are any of them children?"
    },
    {
      "key": "travelers.children",
      "label": "Children",
      "type": "children",
      "tier": "recommended",
      "required_rule": "never",
      "ask_rule": "always",
      "priority": 55,
      "dependencies": ["travelers.adults"],
      "ask_with": [],
      "normalizer": "children",
      "validation_rule": "children",
      "allowed_statuses": ["known", "ambiguous", "not_applicable", "declined"],
      "value_format": "{\"count\": int, \"ages\": [int]}  (ages optional; \"no kids\" = {\"count\": 0})",
      "question_template": "Will any children be coming along?"
    },
    {
      "key": "budget",
      "label": "Budget",
      "type": "budget",
      "tier": "recommended",
      "required_rule": "never",
      "ask_rule": "always",
      "priority": 60,
      "dependencies": [],
      "ask_with": [],
      "normalizer": "budget",
      "validation_rule": "budget",
      "allowed_statuses": ["known", "flexible", "ambiguous", "declined"],
      "value_format": "{\"amount\": number|null, \"min\": number|null, \"max\": number|null, \"currency\": \"ISO 4217 code\", \"basis\": \"total\"|\"per_person\"|null}; \"not decided yet\" = status flexible with null value",
      "question_template": "Do you have a rough budget in mind for the trip?"
    },
    {
      "key": "date_flexibility",
      "label": "Date flexibility",
      "type": "date_flexibility",
      "tier": "recommended",
      "required_rule": "never",
      "ask_rule": "departure_exact",
      "priority": 65,
      "dependencies": ["departure_date"],
      "ask_with": [],
      "normalizer": "date_flexibility",
      "validation_rule": "date_flexibility",
      "allowed_statuses": ["known", "flexible", "declined"],
      "value_format": "{\"mode\": \"fixed\"|\"plus_minus_days\"|\"flexible\", \"days\": int|null}",
      "question_template": "Are your dates fixed, or could you shift them by a few days?"
    },
    {
      "key": "transport_preferences",
      "label": "Transport preferences",
      "type": "list",
      "tier": "optional",
      "required_rule": "never",
      "ask_rule": "never",
      "priority": 80,
      "dependencies": [],
      "ask_with": [],
      "normalizer": "list",
      "validation_rule": "list",
      "allowed_statuses": ["known", "flexible", "declined"],
      "value_format": "{\"items\": [str]}  e.g. {\"items\": [\"flight\", \"train\"]}",
      "question_template": "Do you have a preferred way of getting there (flight, train, car)?"
    },
    {
      "key": "accommodation_preferences",
      "label": "Accommodation preferences",
      "type": "accommodation",
      "tier": "optional",
      "required_rule": "never",
      "ask_rule": "never",
      "priority": 85,
      "dependencies": [],
      "ask_with": [],
      "normalizer": "accommodation",
      "validation_rule": "accommodation",
      "allowed_statuses": ["known", "flexible", "declined"],
      "value_format": "{\"type\": str|null, \"rooms\": int|null, \"location\": str|null, \"min_rating\": number|null, \"notes\": str|null}",
      "question_template": "Any preferences for where you'd like to stay?"
    },
    {
      "key": "travel_constraints",
      "label": "Travel constraints",
      "type": "list",
      "tier": "optional",
      "required_rule": "never",
      "ask_rule": "never",
      "priority": 90,
      "dependencies": [],
      "ask_with": [],
      "normalizer": "list",
      "validation_rule": "list",
      "allowed_statuses": ["known", "declined"],
      "value_format": "{\"items\": [str]}  only constraints the user volunteers (accessibility, dietary, etc.)",
      "question_template": "Is there anything we should keep in mind, such as accessibility needs?"
    },
    {
      "key": "special_requests",
      "label": "Special requests",
      "type": "text",
      "tier": "optional",
      "required_rule": "never",
      "ask_rule": "never",
      "priority": 95,
      "dependencies": [],
      "ask_with": [],
      "normalizer": "text",
      "validation_rule": "text",
      "allowed_statuses": ["known", "declined"],
      "value_format": "{\"text\": str}",
      "question_template": "Anything else you'd like us to know?"
    }
  ]
}
