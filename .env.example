# Copy to .env and fill in. Never commit .env.
# Copy to .env and fill in. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# --- Provider credentials -----------------------------------------------------
# Only the providers referenced by the *_MODEL settings below need a key.
OPENAI_API_KEY=replace_me
GOOGLE_API_KEY=

# --- Models per agent role ------------------------------------------------------
# Provider-qualified IDs: openai:<model> or google_genai:<model>.
# Pin model IDs that your account can access and that passed scripts/run_eval.py.
SUPERVISOR_MODEL=openai:gpt-5.5
SMALL_TALK_MODEL=openai:gpt-5.5
TRAVEL_ENTITY_MODEL=openai:gpt-5.5
QUESTION_GENERATOR_MODEL=openai:gpt-5.5
GUARDRAIL_CLASSIFIER_MODEL=openai:gpt-5.5

# Gemini examples (set GOOGLE_API_KEY and swap any role):
# SUPERVISOR_MODEL=google_genai:gemini-3.1-pro-preview
# SMALL_TALK_MODEL=google_genai:gemini-3.1-pro-preview
# TRAVEL_ENTITY_MODEL=google_genai:gemini-3.1-pro-preview
# QUESTION_GENERATOR_MODEL=google_genai:gemini-3.1-pro-preview
# GUARDRAIL_CLASSIFIER_MODEL=google_genai:gemini-3.1-pro-preview

# Optional fallbacks (only after the fallback passes the same evals):
# SUPERVISOR_FALLBACK_MODEL=google_genai:gemini-3.1-pro-preview
# TRAVEL_ENTITY_FALLBACK_MODEL=google_genai:gemini-3.1-pro-preview

# Optional per-role temperature. Leave unset for models that only accept
# their default temperature (e.g. GPT-5-family reasoning models).
# TRAVEL_ENTITY_TEMPERATURE=0

MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2
STRUCTURED_OUTPUT_RETRIES=1

# --- Persistence (SQLite for development/testing) -------------------------------
DATABASE_URL=sqlite+aiosqlite:///./travel_bot.db
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_DB_PATH=./travel_bot_checkpoints.db
DB_AUTO_CREATE=true
# Production (later): DATABASE_URL=postgresql+asyncpg://user:pass@host/db and
# CHECKPOINT_BACKEND=postgres with langgraph-checkpoint-postgres.

# --- Intake policy --------------------------------------------------------------
REFERENCE_TIMEZONE=UTC
SUPPORTED_LANGUAGES=en,es,fr,de,it,pt
DEFAULT_LANGUAGE=en
HISTORY_WINDOW_MESSAGES=8
ASK_RECOMMENDED_FIELDS=true
MIN_CONFIDENCE_KNOWN=0.6
MAX_PARTY_SIZE=20
SESSION_TTL_HOURS=72

# --- Guardrails / limits --------------------------------------------------------
MAX_MESSAGE_CHARS=2000
RATE_LIMIT_PER_MINUTE=30
# Adds an LLM classifier call per turn on top of the deterministic checks.
GUARDRAIL_LLM_ENABLED=false

# --- Optional LangSmith tracing -------------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=travel-intake-bot
